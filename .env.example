# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Environment ────────────────────────────────────────────────────────────────
# Set to "production" on Railway. Leave unset or "development" locally.
ENV=development

# ── App ────────────────────────────────────────────────────────────────────────
# Used for Stripe redirect URLs (success/cancel/portal return).
# Local dev: http://localhost:8000  |  Production: https://intimeapp.org
APP_URL=http://localhost:8000

# ── Session (REQUIRED) ────────────────────────────────────────────────────────
# Signs session cookies with HMAC — must be set before deploying.
# The app refuses to start in production if this is missing.
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Needed server-side to verify Google ID tokens in /auth/google.
# The value below is the public client ID — safe to keep as default.
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=121246915230-hrfas5irqhnb8sgg8qoc37ba51dqkg0g.apps.googleusercontent.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use the ANON KEY here — NOT the service_role key.
# Get from: supabase.com → project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get from: aistudio.google.com → Get API key
GEMINI_API_KEY=your_gemini_api_key_here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_ for development, sk_live_ for production.
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret.
# Local dev:   stripe listen --forward-to localhost:8000/api/stripe/webhook
# Production:  create endpoint in Stripe dashboard → copy signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Create a Product + Recurring Price in Stripe dashboard → copy the Price ID
STRIPE_PRICE_ID_PRO_MONTHLY=price_...

# ── Railway (auto-injected) ───────────────────────────────────────────────────
# PORT is set automatically by Railway — do NOT set it here or in Railway vars.
# Locally, uvicorn defaults to 8000 if PORT is unset.
